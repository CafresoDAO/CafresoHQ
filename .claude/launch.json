{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cafresohq",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["serve.py"],
      "port": 8799,
      "url": "http://localhost:8799",
      "env": {
        "PORT": "8799",
        "GAP_CRON": "0",
        "NEWS_CRON": "0",
        "TOPICS_CRON": "0"
      }
    },
    {
      "name": "hq-ui-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8934",
        "--directory",
        "hq-ui"
      ],
      "port": 8934
    }
  ]
}
