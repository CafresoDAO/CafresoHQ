# Local config. Copy to `.env` (gitignored) and fill in. All values are read
# from the environment, so you can also export them directly.
#
# Fleet/gateway deploy config (GATEWAY_*, OCI_*, ORACLE_SRC, …) moved to the
# cafreso-fleet repo with the scripts that read it.

# CafresoHQ elevated allowlist (start-elevated.sh); defaults to $HOME/Documents.
# CAFRESOHQ_ALLOWED_DIRS=$HOME/Documents

# API key protecting /tools, /fs/*, and the PTY WebSocket. When unset, those
# endpoints only answer loopback peers.
# CAFRESOHQ_API_KEY=
