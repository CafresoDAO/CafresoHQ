# Local config. Copy to `.env` (gitignored) and fill in. All values are read
# from the environment, so you can also export them directly.
#
# Fleet/gateway deploy config (GATEWAY_*, OCI_*, ORACLE_SRC, …) moved to the
# cafreso-fleet repo with the scripts that read it.

# CafresoHQ elevated allowlist (start-elevated.sh), and the sandbox for the
# keyless /fs read routes. Leaving this UNSET does not mean "off": serve.py
# defaults it to $HOME/Documents, and anything under that tree is readable by
# a loopback caller with no credential. Set it to the narrowest tree you
# actually want reachable.
#
# Setting it to the EMPTY string now means LOCKED — every path check fails and
# the /fs routes refuse everything. (It used to mean the opposite: an empty
# list was read as "allow everything" while the banner printed DISABLED. #315.)
# CAFRESOHQ_ALLOWED_DIRS=$HOME/Documents

# The one opt-out from the path sandbox: any readable path on the host becomes
# fetchable over /fs by a loopback caller. Named in full so it cannot be
# reached by leaving a variable blank. Do not set this on a shared machine.
# CAFRESOHQ_ALLOWED_DIRS_UNRESTRICTED=1

# API key protecting /tools, /fs/*, and the PTY WebSocket. When unset, those
# endpoints only answer loopback peers.
# CAFRESOHQ_API_KEY=

# Local model backends, when they are NOT on this machine. One value each,
# read by both the browser proxy (serve.py ROUTES) and the driver that
# probes them for the front desk — set it here and the two agree. Leave
# unset for the normal case where LM Studio / Ollama run beside the office.
# CAFRESOHQ_LMSTUDIO_URL=http://10.0.0.100:1234/v1
# CAFRESOHQ_OLLAMA_URL=http://10.0.0.100:11434/v1
