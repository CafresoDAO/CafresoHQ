# ── CafresoHQ npm config ────────────────────────────────────────────────────
# engine-strict — `## 405.`
#
# package.json declares `engines.node: ">=18"`, and esbuild and eslint declare
# their own floors. By DEFAULT npm treats every one of those as a warning: a
# tester on Node 16 sees `npm warn EBADENGINE`, scrolled off by 265 packages of
# install output, then a clean "added 265 packages" — and only discovers the
# problem later, from inside the bundler, in a message that never says "Node".
#
# engine-strict turns the warning into a refusal at the FIRST command the README
# tells them to run, with the required and actual versions both named. That is
# the whole point: fail where the fix is, not three steps downstream.
engine-strict=true
