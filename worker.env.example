# ── worker.env.example — copy to `worker.env` ───────────────────────────────
#
#   cp worker.env.example worker.env
#   chmod 600 worker.env
#   docker compose -f docker-compose.local.yml up -d --build
#
# This is the env file for the FULL HQ container (`docker-compose.local.yml`),
# which runs serve.py with the search worker inside it. For the extracted,
# standalone search worker (`docker-compose.worker.yml`) the file is a
# DIFFERENT one — `worker-standalone.env`, with its own template beside this
# one. Do not point one compose file at the other's env file; the standalone
# compose file's header explains why the identities are deliberately separate.
#
# `## 405.` added this file for the same reason as its sibling: the name is
# gitignored, a fresh clone had neither the file nor a template, and Compose
# aborts on a missing env_file before it builds anything.
#
# NOTHING IN HERE IS A SECRET. Every value is a placeholder.

# ── Required, if this container is to answer search jobs ────────────────────
# docker-compose.local.yml currently overrides this to "0" in its
# `environment:` block (all auto-content crons and job polling are off while
# search is hidden). Setting it here does not turn polling on by itself.
SEARCH_WORKER=1
WORKER_PRINCIPAL=
WORKER_SECRET=
BRAVE_API_KEY=

# ── Optional: which brain answers the jobs ──────────────────────────────────
# WORKER_MODEL=
# WORKER_BACKEND_URL=
# WORKER_BACKEND_KEY=
